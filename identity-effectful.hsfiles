{-# START_FILE test/{{name-as-module}}/Unit/Identity/Command/InMemoryUserRepo.hs #-}
module {{name-as-module}}.Unit.Identity.Command.InMemoryUserRepo
  ( run
  ) where

import Relude

import qualified Data.Map.Strict as Map

import Effectful (Eff, IOE, (:>))
import Effectful.Dispatch.Dynamic (interpret)

import {{name-as-module}}.Identity.Command.Domain.User (User (..), UserId)
import {{name-as-module}}.Identity.Command.Domain.UserRepository (UserRepo (..))

run :: (IOE :> es) => IORef (Map UserId User) -> Eff (UserRepo : es) a -> Eff es a
run ref = interpret $ \_ -> \case
  FindById uid -> liftIO $ Map.lookup uid <$> readIORef ref
  FindByEmail email -> liftIO $ do
    users <- readIORef ref
    pure $ find (\u -> u.email == email) (Map.elems users)
  Save user -> liftIO $ modifyIORef ref (Map.insert user.id user)

{-# START_FILE test/{{name-as-module}}/Unit/Identity/Command/InMemoryAuthTokenSvc.hs #-}
module {{name-as-module}}.Unit.Identity.Command.InMemoryAuthTokenSvc
  ( run
  , runWithResult
  ) where

import Relude

import Effectful (Eff)
import Effectful.Dispatch.Dynamic (interpret)

import {{name-as-module}}.Identity.Command.Domain.AuthToken (AuthToken (..))
import {{name-as-module}}.Identity.Command.Domain.AuthTokenService (AuthTokenError, AuthTokenSvc (..))
import {{name-as-module}}.Identity.Command.Domain.User (UserId)

run :: Eff (AuthTokenSvc : es) a -> Eff es a
run = runWithResult $ \uid -> Right $ AuthToken ("test-token-" <> show uid)

runWithResult :: (UserId -> Either AuthTokenError AuthToken) -> Eff (AuthTokenSvc : es) a -> Eff es a
runWithResult resultFor = interpret $ \_ -> \case
  GenerateToken uid -> pure $ resultFor uid

{-# START_FILE test/{{name-as-module}}/Unit/Identity/Command/InMemoryPasswordSvc.hs #-}
module {{name-as-module}}.Unit.Identity.Command.InMemoryPasswordSvc
  ( run
  ) where

import Relude

import Effectful (Eff)
import Effectful.Dispatch.Dynamic (interpret)

import {{name-as-module}}.Identity.Command.Domain.User (HashedPassword (..))
import {{name-as-module}}.Identity.Command.Domain.PasswordService (PasswordSvc (..))

run :: Eff (PasswordSvc : es) a -> Eff es a
run = interpret $ \_ -> \case
  HashPassword raw -> pure $ HashedPassword ("hashed:" <> raw)
  VerifyPassword raw (HashedPassword hashed) -> pure $ hashed == ("hashed:" <> raw)

{-# START_FILE test/{{name-as-module}}/Unit/Identity/Command/UseCase/RegisterSpec.hs #-}
module {{name-as-module}}.Unit.Identity.Command.UseCase.RegisterSpec (spec) where

import Relude

import Effectful (runEff)
import Test.Hspec

import {{name-as-module}}.Identity.Command.Domain.AuthToken (AuthToken (..))
import {{name-as-module}}.Identity.Command.Domain.AuthTokenService (AuthTokenError (..))
import {{name-as-module}}.Identity.Command.Domain.IdentityError (IdentityError (..))
import {{name-as-module}}.Identity.Command.Domain.User (Email (..), UserError (..))

import {{name-as-module}}.Unit.Identity.Command.InMemoryAuthTokenSvc as AuthTokenSvc
import {{name-as-module}}.Unit.Identity.Command.InMemoryPasswordSvc as PasswordSvc
import {{name-as-module}}.Unit.Identity.Command.InMemoryUserRepo as UserRepo

import qualified {{name-as-module}}.Identity.Command.UseCase.Register as Register

spec :: Spec
spec = describe "Register" $ do
  it "registers a new user and returns a token" $ do
    result <- runEff $ do
      userRef <- liftIO $ newIORef mempty
      UserRepo.run userRef
        . AuthTokenSvc.run
        . PasswordSvc.run
        $ Register.execute (Email "test@example.com") "TestUser" "password123"
    case result of
      Right (AuthToken t) -> t `shouldNotBe` ""
      Left err -> expectationFailure $ "Expected Right, got Left " <> show err

  it "returns EmailAlreadyExists for duplicate emails" $ do
    result <- runEff $ do
      userRef <- liftIO $ newIORef mempty
      UserRepo.run userRef
        . AuthTokenSvc.run
        . PasswordSvc.run
        $ do
          _ <- Register.execute (Email "dup@example.com") "User1" "password123"
          Register.execute (Email "dup@example.com") "User2" "password456"
    result `shouldBe` Left (IdentityUserError $ EmailAlreadyExists (Email "dup@example.com"))

  it "returns InvalidPassword for passwords shorter than 4 characters" $ do
    result <- runEff $ do
      userRef <- liftIO $ newIORef mempty
      UserRepo.run userRef
        . AuthTokenSvc.run
        . PasswordSvc.run
        $ Register.execute (Email "short@example.com") "TestUser" "abc"
    case result of
      Left (IdentityUserError (InvalidPassword _)) -> pure ()
      other -> expectationFailure $ "Expected InvalidPassword, got " <> show other

  it "fails for empty names" $ do
    result <- runEff $ do
      userRef <- liftIO $ newIORef mempty
      UserRepo.run userRef
        . AuthTokenSvc.run
        . PasswordSvc.run
        $ Register.execute (Email "noname@example.com") "  " "password123"
    case result of
      Left (IdentityUserError (InvalidPassword _)) -> pure ()
      other -> expectationFailure $ "Expected InvalidPassword, got " <> show other

  it "saves the user after registration" $ do
    (result, users) <- runEff $ do
      userRef <- liftIO $ newIORef mempty
      r <- UserRepo.run userRef
        . AuthTokenSvc.run
        . PasswordSvc.run
        $ Register.execute (Email "saved@example.com") "TestUser" "password123"
      us <- liftIO $ readIORef userRef
      pure (r, us)
    result `shouldSatisfy` isRight
    length users `shouldBe` 1

  it "returns IdentityAuthTokenError when token generation fails" $ do
    let tokenError = AuthTokenGenerationFailed "boom"
    result <- runEff $ do
      userRef <- liftIO $ newIORef mempty
      UserRepo.run userRef
        . AuthTokenSvc.runWithResult (const $ Left tokenError)
        . PasswordSvc.run
        $ Register.execute (Email "token-fail@example.com") "TestUser" "password123"
    result `shouldBe` Left (IdentityAuthTokenError tokenError)

{-# START_FILE test/{{name-as-module}}/Unit/Identity/Command/UseCase/LoginSpec.hs #-}
module {{name-as-module}}.Unit.Identity.Command.UseCase.LoginSpec (spec) where

import Relude

import qualified Data.Map.Strict as Map

import Data.Time.Clock (getCurrentTime)
import Data.UUID.V4 (nextRandom)
import Effectful (runEff)
import Test.Hspec

import {{name-as-module}}.Identity.Command.Domain.AuthToken (AuthToken (..))
import {{name-as-module}}.Identity.Command.Domain.AuthTokenService (AuthTokenError (..))
import {{name-as-module}}.Identity.Command.Domain.IdentityError (IdentityError (..))
import {{name-as-module}}.Identity.Command.Domain.User

import {{name-as-module}}.Unit.Identity.Command.InMemoryAuthTokenSvc as AuthTokenSvc
import {{name-as-module}}.Unit.Identity.Command.InMemoryPasswordSvc as PasswordSvc
import {{name-as-module}}.Unit.Identity.Command.InMemoryUserRepo as UserRepo

import qualified {{name-as-module}}.Identity.Command.UseCase.Login as Login

mkTestUser :: Email -> IO User
mkTestUser email = do
  uid <- UserId <$> nextRandom
  now <- getCurrentTime
  pure $ createUser uid email (HashedPassword "hashed:secret123") "TestUser" now

spec :: Spec
spec = describe "Login" $ do
  it "returns a token for correct email and password" $ do
    let email = Email "user@example.com"
    user <- mkTestUser email
    result <- runEff $ do
      userRef <- liftIO $ newIORef (Map.singleton user.id user)
      UserRepo.run userRef
        . AuthTokenSvc.run
        . PasswordSvc.run
        $ Login.execute email "secret123"
    case result of
      Right (AuthToken t) -> t `shouldNotBe` ""
      Left err -> expectationFailure $ "Expected Right, got Left " <> show err

  it "returns UserNotFoundByEmail for non-existent email" $ do
    let email = Email "nobody@example.com"
    result <- runEff $ do
      userRef <- liftIO $ newIORef mempty
      UserRepo.run userRef
        . AuthTokenSvc.run
        . PasswordSvc.run
        $ Login.execute email "password"
    result `shouldBe` Left (IdentityUserError $ UserNotFoundByEmail email)

  it "returns PasswordMismatch for wrong password" $ do
    let email = Email "user@example.com"
    user <- mkTestUser email
    result <- runEff $ do
      userRef <- liftIO $ newIORef (Map.singleton user.id user)
      UserRepo.run userRef
        . AuthTokenSvc.run
        . PasswordSvc.run
        $ Login.execute email "wrongpassword"
    result `shouldBe` Left (IdentityUserError PasswordMismatch)

  it "returns IdentityAuthTokenError when token generation fails" $ do
    let email = Email "user@example.com"
        tokenError = AuthTokenGenerationFailed "boom"
    user <- mkTestUser email
    result <- runEff $ do
      userRef <- liftIO $ newIORef (Map.singleton user.id user)
      UserRepo.run userRef
        . AuthTokenSvc.runWithResult (const $ Left tokenError)
        . PasswordSvc.run
        $ Login.execute email "secret123"
    result `shouldBe` Left (IdentityAuthTokenError tokenError)

{-# START_FILE test/{{name-as-module}}/Unit/Identity/Command/UseCase/UpdateProfileSpec.hs #-}
module {{name-as-module}}.Unit.Identity.Command.UseCase.UpdateProfileSpec (spec) where

import Relude

import qualified Data.Map.Strict as Map

import Data.Time.Clock (getCurrentTime)
import Data.UUID.V4 (nextRandom)
import Effectful (runEff)
import Test.Hspec

import {{name-as-module}}.Identity.Command.Domain.User
  ( Email (..)
  , HashedPassword (..)
  , User (..)
  , UserError (..)
  , UserId (..)
  , createUser
  )

import {{name-as-module}}.Unit.Identity.Command.InMemoryUserRepo as UserRepo

import qualified {{name-as-module}}.Identity.Command.UseCase.UpdateProfile as UpdateProfile

spec :: Spec
spec = describe "UpdateProfile" $ do
  it "updates the user name" $ do
    uid <- UserId <$> nextRandom
    now <- getCurrentTime
    let user = createUser uid (Email "test@example.com") (HashedPassword "hashed") "OldName" now
    result <- runEff $ do
      userRef <- liftIO $ newIORef (Map.singleton uid user)
      UserRepo.run userRef
        $ UpdateProfile.execute uid "NewName"
    case result of
      Right updated -> updated.name `shouldBe` "NewName"
      Left err -> expectationFailure $ "Expected Right, got Left " <> show err

  it "fails for empty names" $ do
    uid <- UserId <$> nextRandom
    now <- getCurrentTime
    let user = createUser uid (Email "test@example.com") (HashedPassword "hashed") "OldName" now
    result <- runEff $ do
      userRef <- liftIO $ newIORef (Map.singleton uid user)
      UserRepo.run userRef
        $ UpdateProfile.execute uid "  "
    case result of
      Left (InvalidPassword _) -> pure ()
      other -> expectationFailure $ "Expected InvalidPassword, got " <> show other

  it "fails for non-existent user" $ do
    uid <- UserId <$> nextRandom
    result <- runEff $ do
      userRef <- liftIO $ newIORef mempty
      UserRepo.run userRef
        $ UpdateProfile.execute uid "NewName"
    case result of
      Left (UserNotFound _) -> pure ()
      other -> expectationFailure $ "Expected UserNotFound, got " <> show other

  it "trims whitespace from name" $ do
    uid <- UserId <$> nextRandom
    now <- getCurrentTime
    let user = createUser uid (Email "test@example.com") (HashedPassword "hashed") "OldName" now
    result <- runEff $ do
      userRef <- liftIO $ newIORef (Map.singleton uid user)
      UserRepo.run userRef
        $ UpdateProfile.execute uid "  NewName  "
    case result of
      Right updated -> updated.name `shouldBe` "NewName"
      Left err -> expectationFailure $ "Expected Right, got Left " <> show err

{-# START_FILE test/{{name-as-module}}/Integration/TestServer.hs #-}
module {{name-as-module}}.Integration.TestServer
  ( TestEnv (..)
  , withTestServer
  , postJSON
  , putJSON
  , getJSON
  , signupUser
  ) where

import Relude hiding (fromString)

import Data.Aeson (FromJSON, ToJSON, object, (.=))
import qualified Data.Aeson as Aeson
import Data.Pool (destroyAllResources)
import Data.String (fromString)
import Data.UUID.V4 (nextRandom)
import qualified Data.UUID as UUID
import Database.PostgreSQL.Simple (ConnectInfo (..), close, connect, execute_)
import Network.HTTP.Simple
  ( Response
  , defaultRequest
  , getResponseBody
  , getResponseStatusCode
  , httpLBS
  , setRequestBodyJSON
  , setRequestHeader
  , setRequestMethod
  , setRequestPath
  , setRequestPort
  )
import qualified Network.Wai.Handler.Warp as Warp
import Test.Hspec (shouldBe)

import {{name-as-module}}.Identity.Infra.Gateway.JwtAuthTokenGateway (JwtConfig (..))
import {{name-as-module}}.Infra.Persistence.Database (DbConfig (..), DbState (..), initDbState, migrate)
import {{name-as-module}}.ServerApp (AppState (..), mkApp)

data TestEnv = TestEnv
  { port :: Int
  }

testConnectInfo :: String -> ConnectInfo
testConnectInfo dbName = ConnectInfo
  { connectHost = "localhost"
  , connectPort = 5432
  , connectUser = "postgres"
  , connectPassword = "postgres"
  , connectDatabase = dbName
  }

testDbConfig :: String -> DbConfig
testDbConfig dbName = DbConfig
  { host = "localhost"
  , port = 5432
  , user = "postgres"
  , password = "postgres"
  , database = toText dbName
  , poolMaxSize = 20
  , idleTimeoutSec = 30
  }

testJwtConfig :: JwtConfig
testJwtConfig = JwtConfig
  { secretKey = "test-jwt-secret-for-integration-tests"
  , expiryMinutes = 1440
  }

withTestServer :: (TestEnv -> IO a) -> IO a
withTestServer action = do
  -- 1. 테스트 DB 생성
  uuid <- nextRandom
  let dbName = "{{name}}_test_" <> take 8 (UUID.toString uuid)
  adminConn <- connect (testConnectInfo "postgres")
  _ <- execute_ adminConn (fromString $ "CREATE DATABASE \"" <> dbName <> "\"")
  close adminConn

  -- 2. 서버 시작 (migrate 자동)
  dbSt <- initDbState (testDbConfig dbName)
  migrate dbSt
  let appState = AppState dbSt testJwtConfig

  -- 3. 테스트 수행
  result <- Warp.testWithApplication (pure $ mkApp appState) $ \p ->
    action (TestEnv p)

  -- 4. 서버 종료 → DB 삭제
  destroyAllResources dbSt.pool
  cleanupConn <- connect (testConnectInfo "postgres")
  _ <- execute_ cleanupConn (fromString $ "DROP DATABASE \"" <> dbName <> "\"")
  close cleanupConn

  pure result

postJSON :: (ToJSON a) => Int -> ByteString -> a -> Maybe Text -> IO (Response LByteString)
postJSON p path body mToken = httpLBS
  $ maybe Relude.id (\t -> setRequestHeader "Authorization" [encodeUtf8 $ "Bearer " <> t]) mToken
  $ setRequestMethod "POST"
  $ setRequestPath path
  $ setRequestBodyJSON body
  $ setRequestPort p
  $ defaultRequest

putJSON :: (ToJSON a) => Int -> ByteString -> a -> Maybe Text -> IO (Response LByteString)
putJSON p path body mToken = httpLBS
  $ maybe Relude.id (\t -> setRequestHeader "Authorization" [encodeUtf8 $ "Bearer " <> t]) mToken
  $ setRequestMethod "PUT"
  $ setRequestPath path
  $ setRequestBodyJSON body
  $ setRequestPort p
  $ defaultRequest

getJSON :: Int -> ByteString -> Maybe Text -> IO (Response LByteString)
getJSON p path mToken = httpLBS
  $ maybe Relude.id (\t -> setRequestHeader "Authorization" [encodeUtf8 $ "Bearer " <> t]) mToken
  $ setRequestMethod "GET"
  $ setRequestPath path
  $ setRequestPort p
  $ defaultRequest

data RegisterResp = RegisterResp { token :: Text }
  deriving stock (Show, Generic)
  deriving anyclass (FromJSON)

signupUser :: TestEnv -> Text -> Text -> IO Text
signupUser env email password = do
  resp <- postJSON env.port "/api/register"
    (object ["email" .= email, "name" .= email, "password" .= password]) Nothing
  getResponseStatusCode resp `shouldBe` 200
  registerResp <- case Aeson.decode (getResponseBody resp) of
    Just r -> pure (r :: RegisterResp)
    Nothing -> fail "Failed to decode RegisterResp"
  pure registerResp.token

{-# START_FILE test/{{name-as-module}}/Integration/AuthFlowSpec.hs #-}
module {{name-as-module}}.Integration.AuthFlowSpec (spec) where

import Relude

import Data.Aeson (FromJSON, object, (.=))
import qualified Data.Aeson as Aeson
import Network.HTTP.Simple (getResponseBody, getResponseStatusCode)
import Test.Hspec

import {{name-as-module}}.Integration.TestServer (TestEnv (..), getJSON, postJSON, putJSON, signupUser, withTestServer)

data MeResp = MeResp
  { id :: Text
  , email :: Text
  , name :: Text
  }
  deriving stock (Show, Generic)
  deriving anyclass (FromJSON)

data LoginResp = LoginResp { token :: Text }
  deriving stock (Show, Generic)
  deriving anyclass (FromJSON)

spec :: Spec
spec = describe "Integration: Auth Flow" $ do
  it "회원가입 → 로그인 → /me 플로우" $ withTestServer $ \env -> do
    -- 1. 회원가입
    token <- signupUser env "test@example.com" "password123"
    token `shouldNotBe` ""

    -- 2. 로그인
    loginResp <- postJSON env.port "/api/login"
      (object ["email" .= ("test@example.com" :: Text), "password" .= ("password123" :: Text)]) Nothing
    getResponseStatusCode loginResp `shouldBe` 200
    loginData <- case Aeson.decode (getResponseBody loginResp) of
      Just r -> pure (r :: LoginResp)
      Nothing -> fail "Failed to decode LoginResp"
    loginData.token `shouldNotBe` ""

    -- 3. /me 조회
    meResp <- getJSON env.port "/api/me" (Just loginData.token)
    getResponseStatusCode meResp `shouldBe` 200
    meData <- case Aeson.decode (getResponseBody meResp) of
      Just r -> pure (r :: MeResp)
      Nothing -> fail "Failed to decode MeResp"
    meData.email `shouldBe` "test@example.com"

  it "잘못된 비밀번호로 로그인하면 401을 반환한다" $ withTestServer $ \env -> do
    _ <- signupUser env "user@example.com" "correct123"
    loginResp <- postJSON env.port "/api/login"
      (object ["email" .= ("user@example.com" :: Text), "password" .= ("wrong" :: Text)]) Nothing
    getResponseStatusCode loginResp `shouldBe` 401

  it "중복 이메일로 가입하면 409를 반환한다" $ withTestServer $ \env -> do
    _ <- signupUser env "dup@example.com" "password123"
    dupResp <- postJSON env.port "/api/register"
      (object ["email" .= ("dup@example.com" :: Text), "name" .= ("테스트" :: Text), "password" .= ("password456" :: Text)]) Nothing
    getResponseStatusCode dupResp `shouldBe` 409

  it "프로필 이름을 변경한다" $ withTestServer $ \env -> do
    token <- signupUser env "profile@example.com" "password123"

    -- 이름 변경
    updateResp <- putJSON env.port "/api/me"
      (object ["name" .= ("새이름" :: Text)]) (Just token)
    getResponseStatusCode updateResp `shouldBe` 200
    updateData <- case Aeson.decode (getResponseBody updateResp) of
      Just r -> pure (r :: MeResp)
      Nothing -> fail "Failed to decode UpdateProfile response"
    updateData.name `shouldBe` "새이름"

    -- 변경 확인
    meResp <- getJSON env.port "/api/me" (Just token)
    getResponseStatusCode meResp `shouldBe` 200
    meData <- case Aeson.decode (getResponseBody meResp) of
      Just r -> pure (r :: MeResp)
      Nothing -> fail "Failed to decode MeResp"
    meData.name `shouldBe` "새이름"

  it "토큰 없이 /me에 접근하면 401을 반환한다" $ withTestServer $ \env -> do
    meResp <- getJSON env.port "/api/me" Nothing
    getResponseStatusCode meResp `shouldBe` 401
