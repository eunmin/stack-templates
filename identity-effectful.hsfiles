{-# START_FILE app/Main.hs #-}
module Main (main) where

import Relude

import qualified {{name-as-module}}.ServerApp

main :: IO ()
main = {{name-as-module}}.ServerApp.main

{-# START_FILE sql/migrations/0001_init.sql #-}
CREATE TABLE users (
  id UUID PRIMARY KEY,
  email TEXT NOT NULL UNIQUE,
  hashed_password TEXT NOT NULL,
  name TEXT NOT NULL DEFAULT '',
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

{-# START_FILE src/{{name-as-module}}/ServerApp.hs #-}
module {{name-as-module}}.ServerApp (main, mkApp, AppState (..)) where

import Relude hiding (Reader, runReader)

import Effectful (Eff, IOE, runEff)
import Effectful.Error.Dynamic (Error, runErrorNoCallStack)
import Effectful.Reader.Dynamic (Reader, runReader)
import qualified Network.Wai.Handler.Warp as Warp
import Network.Wai (Application)
import Servant
  ( Handler (Handler)
  , ServerError
  , hoistServer
  , hoistServerWithContext
  , serveWithContext
  , type (:<|>) ((:<|>))
  )
import Servant.Swagger.UI (swaggerSchemaUIServer)
import System.Environment (getEnv)

import {{name-as-module}}.Identity.Command.Domain.AuthTokenService (AuthTokenSvc)
import {{name-as-module}}.Identity.Command.Domain.PasswordService (PasswordSvc)
import {{name-as-module}}.Identity.Command.Domain.UserRepository (UserRepo)
import {{name-as-module}}.Identity.Infra.Gateway.JwtAuthTokenGateway (JwtConfig (..))
import {{name-as-module}}.Identity.Infra.Interpreter.AuthTokenSvcInterpreter as AuthTokenSvcInterpreter
import {{name-as-module}}.Identity.Infra.Interpreter.PasswordSvcInterpreter as PasswordSvcInterpreter
import {{name-as-module}}.Identity.Infra.Interpreter.UserRepoInterpreter as UserRepoInterpreter
import {{name-as-module}}.Infra.Persistence.Database (DbConfig (..), DbState, initDbState, migrate)
import {{name-as-module}}.Infra.Web.Auth (AuthContext, mkAuthContext)
import {{name-as-module}}.Infra.Web.Root (rootServerT, wsServerT)
import {{name-as-module}}.Infra.Web.Router (API, WsAPI)
import {{name-as-module}}.Infra.Web.Swagger (FullAPI, swaggerDoc)

type App =
  Eff
    '[ PasswordSvc
     , AuthTokenSvc
     , UserRepo
     , Reader JwtConfig
     , Reader DbState
     , Error ServerError
     , IOE
     ]

data AppState = AppState
  { dbState :: DbState
  , jwtConfig :: JwtConfig
  }

runner :: AppState -> App a -> IO (Either ServerError a)
runner appState =
  runEff
    . runErrorNoCallStack
    . runReader appState.dbState
    . runReader appState.jwtConfig
    . UserRepoInterpreter.run
    . AuthTokenSvcInterpreter.run
    . PasswordSvcInterpreter.run

handlerRunner :: AppState -> App a -> Handler a
handlerRunner appState = Handler . ExceptT . runner appState

configFromEnv :: IO (DbConfig, JwtConfig, Int)
configFromEnv = do
  dbHost <- getEnv "DB_HOST" <&> toText
  dbPort <- getEnv "DB_PORT" <&> (fromMaybe 5432 . readMaybe)
  dbUser <- getEnv "DB_USER" <&> toText
  dbPassword <- getEnv "DB_PASSWORD" <&> toText
  dbDatabase <- getEnv "DB_DATABASE" <&> toText
  dbPoolSize <- lookupEnv "DB_POOL_MAX_SIZE" <&> (fromMaybe 10 . (>>= readMaybe))
  dbIdleTimeout <- lookupEnv "DB_POOL_IDLE_TIMEOUT" <&> (fromMaybe 30.0 . (>>= readMaybe))
  jwtSecret <- getEnv "JWT_SECRET" <&> toText
  jwtExpiry <- lookupEnv "JWT_EXPIRY_MINUTES" <&> (fromMaybe 1440 . (>>= readMaybe))
  port <- lookupEnv "PORT" <&> (fromMaybe 8080 . (>>= readMaybe))
  let dbConfig = DbConfig
        { host = dbHost
        , port = dbPort
        , user = dbUser
        , password = dbPassword
        , database = dbDatabase
        , poolMaxSize = dbPoolSize
        , idleTimeoutSec = dbIdleTimeout
        }
      jwtCfg = JwtConfig
        { secretKey = jwtSecret
        , expiryMinutes = jwtExpiry
        }
  pure (dbConfig, jwtCfg, port)

mkApp :: AppState -> Application
mkApp appState =
  let context = mkAuthContext appState.jwtConfig.secretKey
  in serveWithContext
       (Proxy :: Proxy FullAPI)
       context
       (swaggerSchemaUIServer swaggerDoc
        :<|> hoistServerWithContext
               (Proxy :: Proxy API)
               (Proxy :: Proxy AuthContext)
               (handlerRunner appState)
               rootServerT
        :<|> hoistServer
               (Proxy :: Proxy WsAPI)
               (handlerRunner appState)
               wsServerT)

main :: IO ()
main = do
  (dbConfig, jwtCfg, port) <- configFromEnv
  dbSt <- initDbState dbConfig
  migrate dbSt
  let appState = AppState dbSt jwtCfg
  putStrLn $ "Starting server on port " <> show port
  Warp.run port (mkApp appState)

{-# START_FILE src/{{name-as-module}}/Echo/Infra/Web/Handler/Echo.hs #-}
module {{name-as-module}}.Echo.Infra.Web.Handler.Echo
  ( Route
  , handler
  ) where

import Relude

import qualified Effectful as Eff
import Effectful (Eff)
import qualified Network.WebSockets as WS
import Servant (type (:>))
import Servant.API.WebSocket (WebSocket)

type Route = "echo" :> WebSocket

handler :: (Eff.IOE Eff.:> es) => WS.Connection -> Eff es ()
handler conn =
  Eff.liftIO $
    WS.withPingThread conn 30 (pure ()) $
      forever $ do
        msg <- WS.receiveData conn :: IO Text
        WS.sendTextData conn msg

{-# START_FILE src/{{name-as-module}}/Identity/Command/Domain/User.hs #-}
module {{name-as-module}}.Identity.Command.Domain.User
  ( User (..)
  , UserId (..)
  , Email (..)
  , HashedPassword (..)
  , UserError (..)
  , mkEmail
  , createUser
  ) where

import Relude

import Data.Aeson (FromJSON, ToJSON)
import Data.Time (UTCTime)
import Data.UUID (UUID)
import qualified Data.Text as T
import Database.PostgreSQL.Simple.FromField (FromField)
import Database.PostgreSQL.Simple.ToField (ToField)
import Database.PostgreSQL.Simple.FromRow (FromRow)
import Database.PostgreSQL.Simple.ToRow (ToRow)

newtype UserId = UserId UUID
  deriving stock (Eq, Ord, Show)
  deriving newtype (FromField, ToField, FromJSON, ToJSON)

newtype Email = Email Text
  deriving stock (Eq, Show)
  deriving newtype (FromField, ToField, FromJSON, ToJSON)

newtype HashedPassword = HashedPassword Text
  deriving stock (Eq, Show)
  deriving newtype (FromField, ToField)

data User = User
  { id :: UserId
  , email :: Email
  , hashedPassword :: HashedPassword
  , name :: Text
  , createdAt :: UTCTime
  }
  deriving stock (Eq, Show, Generic)
  deriving anyclass (FromRow, ToRow)

data UserError
  = UserNotFound UserId
  | UserNotFoundByEmail Email
  | EmailAlreadyExists Email
  | InvalidEmail Text
  | InvalidPassword Text
  | PasswordMismatch
  deriving stock (Eq, Show)

mkEmail :: Text -> Either UserError Email
mkEmail t
  | T.null t = Left (InvalidEmail "Email cannot be empty")
  | not ("@" `T.isInfixOf` t) = Left (InvalidEmail "Invalid email format")
  | otherwise = Right (Email t)

createUser :: UserId -> Email -> HashedPassword -> Text -> UTCTime -> User
createUser uid email hashedPw name now = User
  { id = uid
  , email = email
  , hashedPassword = hashedPw
  , name = name
  , createdAt = now
  }

