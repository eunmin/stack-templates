{-# START_FILE src/{{name-as-module}}/Infra/Persistence/Database.hs #-}
module {{name-as-module}}.Infra.Persistence.Database
  ( DbConfig (..)
  , DbState (..)
  , initDbState
  , withConnection
  , withTx
  , migrate
  ) where

import Relude hiding (Reader, ask, local)

import Data.Pool (Pool, defaultPoolConfig, newPool, destroyResource, putResource, takeResource)
import Database.PostgreSQL.Simple.Migration
  ( MigrationCommand (..)
  , MigrationResult (..)
  , defaultOptions
  , runMigrations
  )
import Database.PostgreSQL.Simple
  ( Connection
  , ConnectInfo (..)
  , close
  , commit
  , connect
  , rollback
  )
import Database.PostgreSQL.Simple.Transaction
  ( IsolationLevel (..)
  , ReadWriteMode (..)
  , TransactionMode (..)
  , beginMode
  )
import Effectful (Eff, IOE, (:>))
import Effectful.Exception (onException)
import Effectful.Reader.Dynamic (Reader, ask, local)

data DbConfig = DbConfig
  { host :: Text
  , port :: Int
  , user :: Text
  , password :: Text
  , database :: Text
  , poolMaxSize :: Int
  , idleTimeoutSec :: Double
  }

data DbState = DbState
  { pool :: Pool Connection
  , txConn :: Maybe Connection
  , txMode :: TransactionMode
  }

initDbState :: DbConfig -> IO DbState
initDbState config = do
  p <- newPool $ defaultPoolConfig openConn close config.idleTimeoutSec config.poolMaxSize
  pure $ DbState p Nothing defaultTxMode
  where
    openConn = connect $ ConnectInfo
      { connectHost = toString config.host
      , connectPort = fromIntegral config.port
      , connectUser = toString config.user
      , connectPassword = toString config.password
      , connectDatabase = toString config.database
      }
    defaultTxMode = TransactionMode ReadCommitted ReadWrite

migrate :: DbState -> IO ()
migrate st = do
  (conn, localPool) <- takeResource st.pool
  result <- runMigrations conn defaultOptions
    [MigrationInitialization, MigrationDirectory "sql/migrations"]
  putResource localPool conn
  case result of
    MigrationError err -> error $ "Migration failed: " <> show err
    _ -> putStrLn "Migration completed successfully"

withResource :: (IOE :> es) => Pool a -> (a -> Eff es r) -> Eff es r
withResource p act = do
  (res, localPool) <- liftIO $ takeResource p
  r <- act res `onException` liftIO (destroyResource p localPool res)
  liftIO $ putResource localPool res
  pure r

withConnection ::
  (IOE :> es, Reader DbState :> es) =>
  (Connection -> Eff es a) ->
  Eff es a
withConnection action = do
  st <- ask @DbState
  case st.txConn of
    Just conn -> action conn
    Nothing -> withResource st.pool action

withTx ::
  (IOE :> es, Reader DbState :> es) =>
  Eff es a ->
  Eff es a
withTx action = do
  st <- ask @DbState
  withResource st.pool $ \conn -> do
    liftIO $ beginMode st.txMode conn
    r <- local (const (DbState st.pool (Just conn) st.txMode)) action
      `onException` liftIO (rollback conn)
    liftIO $ commit conn
    pure r

{-# START_FILE src/{{name-as-module}}/Infra/Web/Auth.hs #-}
{-# OPTIONS_GHC -Wno-orphans #-}

module {{name-as-module}}.Infra.Web.Auth
  ( AuthToken (..)
  , AuthContext
  , mkAuthContext
  , parseJwt
  ) where

import Relude hiding ((&))

import Data.List (lookup)

import Control.Monad.Except (throwError)

import Control.Lens ((^.), (^?))
import Crypto.JOSE.Compact (decodeCompact)
import Crypto.JOSE.JWK (fromOctets)
import Crypto.JWT
  ( ClaimsSet
  , JWTError (..)
  , SignedJWT
  , claimSub
  , defaultJWTValidationSettings
  , runJOSE
  , string
  , verifyJWT
  )
import qualified Data.ByteString.Lazy as L
import Network.Wai (Request, requestHeaders)
import Servant (Context (EmptyContext, (:.)))
import Servant.API.Experimental.Auth (AuthProtect)
import Servant.Server (err401)
import Servant.Server.Experimental.Auth (AuthHandler, AuthServerData, mkAuthHandler)

import qualified Data.Text as T
import qualified Data.Text.Encoding as TE

data AuthToken = AuthToken
  { userId :: Text
  }

type instance AuthServerData (AuthProtect "jwt") = AuthToken

type AuthContext = '[AuthHandler Request AuthToken]

mkAuthContext :: Text -> Context AuthContext
mkAuthContext secret = authHandler secret :. EmptyContext

authHandler :: Text -> AuthHandler Request AuthToken
authHandler secret = mkAuthHandler $ \req -> do
  case extractBearerToken req of
    Nothing -> throwError err401
    Just token -> do
      result <- liftIO $ parseJwt secret token
      case result of
        Left _ -> throwError err401
        Right sub -> pure $ AuthToken sub

extractBearerToken :: Request -> Maybe Text
extractBearerToken req = do
  authHeader <- lookup "Authorization" (requestHeaders req)
  let headerText = TE.decodeUtf8 authHeader
  T.stripPrefix "Bearer " headerText

parseJwt :: Text -> Text -> IO (Either JWTError Text)
parseJwt secret token = do
  result :: Either JWTError ClaimsSet <- runJOSE $ do
    let jwk = fromOctets (encodeUtf8 secret :: L.ByteString)
        audCheck = (== "{{name}}")
    jwt :: SignedJWT <- decodeCompact $ L.fromStrict $ encodeUtf8 token
    verifyJWT (defaultJWTValidationSettings audCheck) jwk jwt
  pure $ case result of
    Left err -> Left err
    Right claims ->
      case claims ^. claimSub >>= (^? string) of
        Nothing -> Left (JWTClaimsSetDecodeError "Missing sub claim")
        Just t -> Right t

{-# START_FILE src/{{name-as-module}}/Infra/Web/ErrorResponse.hs #-}
module {{name-as-module}}.Infra.Web.ErrorResponse
  ( ErrorResponse (..)
  , badRequest
  , unauthorized
  , forbidden
  , notFound
  , conflict
  , internalServerError
  ) where

import Relude

import Data.Aeson (ToJSON)
import qualified Data.Aeson as JSON
import Data.Swagger (ToSchema)
import Servant.Server
  ( ServerError (errBody, errHeaders)
  , err400
  , err401
  , err403
  , err404
  , err409
  , err500
  )

data ErrorResponse = ErrorResponse
  { title :: Text
  , message :: Text
  , code :: Text
  }
  deriving stock (Eq, Show, Generic)
  deriving anyclass (ToJSON, ToSchema)

jsonError :: ServerError -> ErrorResponse -> ServerError
jsonError serverError err =
  serverError
    { errBody = JSON.encode err
    , errHeaders = [("Content-Type", "application/json")]
    }

badRequest :: Text -> Text -> Text -> ServerError
badRequest t m c = jsonError err400 (ErrorResponse t m c)

unauthorized :: Text -> Text -> Text -> ServerError
unauthorized t m c = jsonError err401 (ErrorResponse t m c)

forbidden :: Text -> Text -> Text -> ServerError
forbidden t m c = jsonError err403 (ErrorResponse t m c)

notFound :: Text -> Text -> Text -> ServerError
notFound t m c = jsonError err404 (ErrorResponse t m c)

conflict :: Text -> Text -> Text -> ServerError
conflict t m c = jsonError err409 (ErrorResponse t m c)

internalServerError :: Text -> Text -> Text -> ServerError
internalServerError t m c = jsonError err500 (ErrorResponse t m c)

{-# START_FILE src/{{name-as-module}}/Infra/Web/Root.hs #-}
module {{name-as-module}}.Infra.Web.Root
  ( rootServerT
  , wsServerT
  ) where

import Effectful (Eff)
import qualified Effectful as Eff
import Effectful.Error.Dynamic (Error)
import Effectful.Reader.Dynamic (Reader)
import Servant (ServerError, ServerT, type (:<|>) ((:<|>)))

import {{name-as-module}}.Identity.Command.Domain.AuthTokenService (AuthTokenSvc)
import {{name-as-module}}.Identity.Command.Domain.PasswordService (PasswordSvc)
import {{name-as-module}}.Identity.Command.Domain.UserRepository (UserRepo)
import {{name-as-module}}.Identity.Infra.Gateway.JwtAuthTokenGateway (JwtConfig)

import qualified {{name-as-module}}.Echo.Infra.Web.Handler.Echo as Echo
import {{name-as-module}}.Infra.Web.Auth (AuthToken)
import {{name-as-module}}.Infra.Web.Router (API, ProtectedAPI, UnProtectedAPI, WsAPI)
import qualified {{name-as-module}}.Identity.Infra.Web.Handler.Register as Register
import qualified {{name-as-module}}.Identity.Infra.Web.Handler.Login as Login
import qualified {{name-as-module}}.Identity.Infra.Web.Handler.GetMe as GetMe
import qualified {{name-as-module}}.Identity.Infra.Web.Handler.UpdateProfile as UpdateProfile

type Effs es =
  ( Eff.IOE Eff.:> es
  , Error ServerError Eff.:> es
  , UserRepo Eff.:> es
  , AuthTokenSvc Eff.:> es
  , PasswordSvc Eff.:> es
  , Reader JwtConfig Eff.:> es
  )

rootServerT :: (Effs es) => ServerT API (Eff es)
rootServerT = unProtectedServerT :<|> protectedServerT

wsServerT :: (Eff.IOE Eff.:> es) => ServerT WsAPI (Eff es)
wsServerT = Echo.handler

unProtectedServerT :: (Effs es) => ServerT UnProtectedAPI (Eff es)
unProtectedServerT =
  Register.handler
  :<|> Login.handler

protectedServerT :: (Effs es) => AuthToken -> ServerT ProtectedAPI (Eff es)
protectedServerT token =
  GetMe.handler token
  :<|> UpdateProfile.handler token

{-# START_FILE src/{{name-as-module}}/Infra/Web/Router.hs #-}
module {{name-as-module}}.Infra.Web.Router
  ( API
  , WsAPI
  , UnProtectedAPI
  , ProtectedAPI
  ) where

import Servant (type (:<|>), type (:>))
import Servant.API.Experimental.Auth (AuthProtect)

import qualified {{name-as-module}}.Echo.Infra.Web.Handler.Echo as Echo
import qualified {{name-as-module}}.Identity.Infra.Web.Handler.Register as Register
import qualified {{name-as-module}}.Identity.Infra.Web.Handler.Login as Login
import qualified {{name-as-module}}.Identity.Infra.Web.Handler.GetMe as GetMe
import qualified {{name-as-module}}.Identity.Infra.Web.Handler.UpdateProfile as UpdateProfile

type API = "api" :> (UnProtectedAPI :<|> AuthProtect "jwt" :> ProtectedAPI)

type WsAPI = "ws" :> Echo.Route

type UnProtectedAPI =
  Register.Route
  :<|> Login.Route

type ProtectedAPI =
  GetMe.Route
  :<|> UpdateProfile.Route

{-# START_FILE src/{{name-as-module}}/Infra/Web/Swagger.hs #-}
{-# OPTIONS_GHC -Wno-orphans #-}
module {{name-as-module}}.Infra.Web.Swagger
  ( SwaggerAPI
  , FullAPI
  , swaggerDoc
  ) where

import Relude

import Data.Swagger
  ( Swagger
  , HasDescription (..)
  , HasInfo (..)
  , HasTitle (..)
  , HasVersion (..)
  )
import Control.Lens ((.~), (?~))
import Servant (type (:<|>), type (:>))
import Servant.API.Experimental.Auth (AuthProtect)
import Servant.Swagger (HasSwagger (..), toSwagger)
import Servant.Swagger.UI (SwaggerSchemaUI)

import {{name-as-module}}.Infra.Web.Router (API, WsAPI)

-- | Orphan HasSwagger instance for AuthProtect "jwt"
instance HasSwagger api => HasSwagger (AuthProtect "jwt" :> api) where
  toSwagger _ = toSwagger (Proxy :: Proxy api)

type SwaggerAPI = SwaggerSchemaUI "swagger-ui" "swagger.json"

type FullAPI = SwaggerAPI :<|> API :<|> WsAPI

swaggerDoc :: Swagger
swaggerDoc =
  toSwagger (Proxy :: Proxy API)
    & info . title .~ "{{name}} API"
    & info . version .~ "0.1.0.0"
    & info . description ?~ "Identity API"

{-# START_FILE src/{{name-as-module}}/Util/Log.hs #-}
module {{name-as-module}}.Util.Log
  ( log
  , logError
  , logWarn
  , logInfo
  , logDebug
  , runLogger
  ) where

import Relude

import Effectful (Eff, IOE, (:>))
import Effectful.Katip (KatipE, runKatipContextE)
import Katip
  ( ColorStrategy (ColorIfTerminal)
  , Severity (..)
  , Verbosity (V2)
  , bracketFormat
  , defaultScribeSettings
  , initLogEnv
  , logTM
  , ls
  , mkHandleScribeWithFormatter
  , permitItem
  , registerScribe
  )

log :: (KatipE :> es, IOE :> es) => Severity -> Text -> Eff es ()
log level message =
  $(logTM) level
    $ ls message

logError :: (KatipE :> es, IOE :> es) => Text -> Eff es ()
logError = log ErrorS

logWarn :: (KatipE :> es, IOE :> es) => Text -> Eff es ()
logWarn = log WarningS

logInfo :: (KatipE :> es, IOE :> es) => Text -> Eff es ()
logInfo = log InfoS

logDebug :: (KatipE :> es, IOE :> es) => Text -> Eff es ()
logDebug = log DebugS

runLogger :: (IOE :> es) => Eff (KatipE : es) a -> Eff es a
runLogger act = do
  le <- liftIO $ do
    handleScribe <- mkHandleScribeWithFormatter
      bracketFormat
      ColorIfTerminal
      stdout
      (permitItem DebugS)
      V2
    registerScribe "stdout" handleScribe defaultScribeSettings
      =<< initLogEnv "{{name}}" "dev"
  runKatipContextE le () "main" act

