{-# START_FILE src/{{name-as-module}}/Identity/Command/UseCase/Register.hs #-}
module {{name-as-module}}.Identity.Command.UseCase.Register
  ( execute
  ) where

import Relude

import qualified Data.Text as T
import Data.UUID.V4 (nextRandom)
import Data.Time (getCurrentTime)
import Effectful (Eff, IOE, (:>))
import Effectful.Error.Dynamic (runErrorNoCallStack, throwError)

import {{name-as-module}}.Identity.Command.Domain.AuthToken (AuthToken)
import {{name-as-module}}.Identity.Command.Domain.AuthTokenService (AuthTokenSvc, generateToken)
import {{name-as-module}}.Identity.Command.Domain.IdentityError (IdentityError (..))
import {{name-as-module}}.Identity.Command.Domain.PasswordService (PasswordSvc, hashPassword)
import {{name-as-module}}.Identity.Command.Domain.User
  ( Email
  , UserError (..)
  , UserId (..)
  , createUser
  )
import {{name-as-module}}.Identity.Command.Domain.UserRepository (UserRepo, findByEmail, save)

execute ::
  (UserRepo :> es, AuthTokenSvc :> es, PasswordSvc :> es, IOE :> es) =>
  Email -> Text -> Text -> Eff es (Either IdentityError AuthToken)
execute email name rawPassword = runErrorNoCallStack $ do
  existing <- findByEmail email
  case existing of
    Just _ -> throwError $ IdentityUserError $ EmailAlreadyExists email
    Nothing -> pure ()

  when (T.null $ T.strip name) $
    throwError $ IdentityUserError $ InvalidPassword "Name is required"

  when (T.length rawPassword < 4) $
    throwError $ IdentityUserError $ InvalidPassword "Password must be at least 4 characters"

  hashedPw <- hashPassword rawPassword
  uid <- liftIO $ UserId <$> nextRandom
  now <- liftIO getCurrentTime
  let user = createUser uid email hashedPw (T.strip name) now
  save user
  generateToken uid >>= either (throwError . IdentityAuthTokenError) pure

{-# START_FILE src/{{name-as-module}}/Identity/Command/UseCase/Login.hs #-}
module {{name-as-module}}.Identity.Command.UseCase.Login
  ( execute
  ) where

import Relude

import Effectful (Eff, (:>))
import Effectful.Error.Dynamic (runErrorNoCallStack, throwError)

import {{name-as-module}}.Identity.Command.Domain.AuthToken (AuthToken)
import {{name-as-module}}.Identity.Command.Domain.AuthTokenService (AuthTokenSvc, generateToken)
import {{name-as-module}}.Identity.Command.Domain.IdentityError (IdentityError (..))
import {{name-as-module}}.Identity.Command.Domain.PasswordService (PasswordSvc, verifyPassword)
import {{name-as-module}}.Identity.Command.Domain.User (Email, User (..), UserError (..))
import {{name-as-module}}.Identity.Command.Domain.UserRepository (UserRepo, findByEmail)

execute ::
  (UserRepo :> es, AuthTokenSvc :> es, PasswordSvc :> es) =>
  Email -> Text -> Eff es (Either IdentityError AuthToken)
execute email rawPassword = runErrorNoCallStack $ do
  user <- findByEmail email >>= maybe (throwError $ IdentityUserError $ UserNotFoundByEmail email) pure
  valid <- verifyPassword rawPassword user.hashedPassword
  unless valid $ throwError $ IdentityUserError PasswordMismatch
  generateToken user.id >>= either (throwError . IdentityAuthTokenError) pure

{-# START_FILE src/{{name-as-module}}/Identity/Command/UseCase/UpdateProfile.hs #-}
module {{name-as-module}}.Identity.Command.UseCase.UpdateProfile
  ( execute
  ) where

import Relude

import qualified Data.Text as T
import Effectful (Eff, (:>))
import Effectful.Error.Dynamic (runErrorNoCallStack, throwError)

import {{name-as-module}}.Identity.Command.Domain.User (User (..), UserError (..), UserId)
import {{name-as-module}}.Identity.Command.Domain.UserRepository (UserRepo, findById, save)

execute ::
  (UserRepo :> es) =>
  UserId -> Text -> Eff es (Either UserError User)
execute userId newName = runErrorNoCallStack $ do
  user <- findById userId >>= maybe (throwError $ UserNotFound userId) pure

  when (T.null $ T.strip newName) $
    throwError $ InvalidPassword "Name is required"

  let updatedUser = user { name = T.strip newName }
  save updatedUser
  pure updatedUser

{-# START_FILE src/{{name-as-module}}/Identity/Query/GetMe.hs #-}
module {{name-as-module}}.Identity.Query.GetMe
  ( execute
  ) where

import Relude

import Effectful (Eff, (:>))
import Effectful.Error.Dynamic (runErrorNoCallStack, throwError)

import {{name-as-module}}.Identity.Command.Domain.User (User, UserError (..), UserId)
import {{name-as-module}}.Identity.Command.Domain.UserRepository (UserRepo, findById)

execute ::
  (UserRepo :> es) =>
  UserId -> Eff es (Either UserError User)
execute uid = runErrorNoCallStack $ do
  findById uid >>= maybe (throwError $ UserNotFound uid) pure

{-# START_FILE src/{{name-as-module}}/Identity/Infra/Gateway/JwtAuthTokenGateway.hs #-}
module {{name-as-module}}.Identity.Infra.Gateway.JwtAuthTokenGateway
  ( JwtConfig (..)
  , generate
  ) where

import Relude hiding (Reader, ask)

import Control.Lens ((?~), review)
import Crypto.JOSE.JWK (fromOctets)
import Crypto.JWT
  ( Audience (Audience)
  , JWTError
  , NumericDate (NumericDate)
  , SignedJWT
  , bestJWSAlg
  , claimAud
  , claimExp
  , claimIat
  , claimIss
  , claimSub
  , emptyClaimsSet
  , newJWSHeaderProtected
  , runJOSE
  , signJWT
  , string
  )
import Crypto.JOSE.Compact (encodeCompact)
import Data.Time (NominalDiffTime, addUTCTime, getCurrentTime)
import qualified Data.UUID as UUID
import qualified Data.ByteString.Lazy as L
import Effectful (Eff, IOE, (:>))
import Effectful.Reader.Dynamic (Reader, ask)

import {{name-as-module}}.Identity.Command.Domain.AuthToken (AuthToken (..))
import {{name-as-module}}.Identity.Command.Domain.AuthTokenService (AuthTokenError (..))
import {{name-as-module}}.Identity.Command.Domain.User (UserId (..))

data JwtConfig = JwtConfig
  { secretKey :: Text
  , expiryMinutes :: NominalDiffTime
  }

generate :: (Reader JwtConfig :> es, IOE :> es) => UserId -> Eff es (Either AuthTokenError AuthToken)
generate (UserId uuid) = do
  config <- ask @JwtConfig
  now <- liftIO getCurrentTime
  let jwk = fromOctets (encodeUtf8 config.secretKey :: L.ByteString)
      claims = emptyClaimsSet
        & claimIss ?~ "{{name}}"
        & claimSub ?~ review string (UUID.toText uuid)
        & claimAud ?~ Audience ["{{name}}"]
        & claimIat ?~ NumericDate now
        & claimExp ?~ NumericDate (addUTCTime (config.expiryMinutes * 60) now)
  result :: Either JWTError SignedJWT <- liftIO $ runJOSE $ do
    alg <- bestJWSAlg jwk
    signJWT jwk (newJWSHeaderProtected alg) claims
  case result of
    Left err -> pure $ Left $ AuthTokenGenerationFailed $ show err
    Right jwt -> pure $ Right $ AuthToken $ decodeUtf8 $ encodeCompact jwt

{-# START_FILE src/{{name-as-module}}/Identity/Infra/Gateway/BcryptPasswordGateway.hs #-}
module {{name-as-module}}.Identity.Infra.Gateway.BcryptPasswordGateway
  ( hash
  , verify
  ) where

import Relude

import qualified Crypto.BCrypt as BCrypt
import Effectful (Eff, IOE, (:>))

import {{name-as-module}}.Identity.Command.Domain.User (HashedPassword (..))

hash :: (IOE :> es) => Text -> Eff es HashedPassword
hash rawPassword = do
  result <- liftIO $ BCrypt.hashPasswordUsingPolicy
    BCrypt.slowerBcryptHashingPolicy
    (encodeUtf8 rawPassword)
  case result of
    Nothing -> error "Failed to hash password"
    Just hashed -> pure $ HashedPassword $ decodeUtf8 hashed

verify :: Text -> HashedPassword -> Bool
verify rawPassword (HashedPassword hashed) =
  BCrypt.validatePassword (encodeUtf8 hashed) (encodeUtf8 rawPassword)

{-# START_FILE src/{{name-as-module}}/Identity/Infra/Interpreter/UserRepoInterpreter.hs #-}
module {{name-as-module}}.Identity.Infra.Interpreter.UserRepoInterpreter
  ( run
  ) where

import Relude hiding (Reader)

import Effectful (Eff, IOE, (:>))
import Effectful.Dispatch.Dynamic (interpret)
import Effectful.Reader.Dynamic (Reader)

import {{name-as-module}}.Identity.Command.Domain.UserRepository (UserRepo (..))
import {{name-as-module}}.Infra.Persistence.Database (DbState)
import qualified {{name-as-module}}.Identity.Infra.Persistence.PgUserRepo as PgUserRepo

run :: (Reader DbState :> es, IOE :> es) => Eff (UserRepo : es) a -> Eff es a
run = interpret $ \_ -> \case
  FindById uid -> PgUserRepo.findById uid
  FindByEmail email -> PgUserRepo.findByEmail email
  Save user -> PgUserRepo.save user

{-# START_FILE src/{{name-as-module}}/Identity/Infra/Interpreter/AuthTokenSvcInterpreter.hs #-}
module {{name-as-module}}.Identity.Infra.Interpreter.AuthTokenSvcInterpreter
  ( run
  ) where

import Relude hiding (Reader)

import Effectful (Eff, IOE, (:>))
import Effectful.Dispatch.Dynamic (interpret)
import Effectful.Reader.Dynamic (Reader)

import {{name-as-module}}.Identity.Command.Domain.AuthTokenService (AuthTokenSvc (..))
import {{name-as-module}}.Identity.Infra.Gateway.JwtAuthTokenGateway (JwtConfig)
import qualified {{name-as-module}}.Identity.Infra.Gateway.JwtAuthTokenGateway as JwtGateway

run :: (Reader JwtConfig :> es, IOE :> es) => Eff (AuthTokenSvc : es) a -> Eff es a
run = interpret $ \_ -> \case
  GenerateToken uid -> JwtGateway.generate uid

{-# START_FILE src/{{name-as-module}}/Identity/Infra/Interpreter/PasswordSvcInterpreter.hs #-}
module {{name-as-module}}.Identity.Infra.Interpreter.PasswordSvcInterpreter
  ( run
  ) where

import Relude

import Effectful (Eff, IOE, (:>))
import Effectful.Dispatch.Dynamic (interpret)

import {{name-as-module}}.Identity.Command.Domain.PasswordService (PasswordSvc (..))
import qualified {{name-as-module}}.Identity.Infra.Gateway.BcryptPasswordGateway as BcryptGateway

run :: (IOE :> es) => Eff (PasswordSvc : es) a -> Eff es a
run = interpret $ \_ -> \case
  HashPassword rawPassword -> BcryptGateway.hash rawPassword
  VerifyPassword rawPassword hashed -> pure $ BcryptGateway.verify rawPassword hashed

{-# START_FILE src/{{name-as-module}}/Identity/Infra/Persistence/PgUserRepo.hs #-}
module {{name-as-module}}.Identity.Infra.Persistence.PgUserRepo
  ( findById
  , findByEmail
  , save
  ) where

import Relude hiding (Reader)

import Database.PostgreSQL.Simple (query, execute)
import Database.PostgreSQL.Simple.SqlQQ (sql)
import Effectful (Eff, IOE, (:>))
import Effectful.Reader.Dynamic (Reader)
import Safe (headMay)

import {{name-as-module}}.Identity.Command.Domain.User (Email, User, UserId)
import {{name-as-module}}.Infra.Persistence.Database (DbState, withConnection)

findById :: (Reader DbState :> es, IOE :> es) => UserId -> Eff es (Maybe User)
findById uid =
  withConnection $ \conn -> do
    rows <- liftIO $ query conn
      [sql|
        SELECT id, email, hashed_password, name, created_at
        FROM users
        WHERE id = ?
      |]
      [uid]
    pure $ headMay rows

findByEmail :: (Reader DbState :> es, IOE :> es) => Email -> Eff es (Maybe User)
findByEmail email =
  withConnection $ \conn -> do
    rows <- liftIO $ query conn
      [sql|
        SELECT id, email, hashed_password, name, created_at
        FROM users
        WHERE email = ?
      |]
      [email]
    pure $ headMay rows

save :: (Reader DbState :> es, IOE :> es) => User -> Eff es ()
save user =
  withConnection $ \conn -> do
    void $ liftIO $ execute conn
      [sql|
        INSERT INTO users (id, email, hashed_password, name, created_at)
        VALUES (?, ?, ?, ?, ?)
        ON CONFLICT (id) DO UPDATE SET
          email = EXCLUDED.email,
          hashed_password = EXCLUDED.hashed_password,
          name = EXCLUDED.name
      |]
      user

{-# START_FILE src/{{name-as-module}}/Identity/Infra/Web/Handler/Register.hs #-}
module {{name-as-module}}.Identity.Infra.Web.Handler.Register
  ( Route
  , handler
  ) where

import Relude

import Data.Aeson (FromJSON, ToJSON)
import Data.Swagger (ToSchema)
import Effectful (Eff, IOE)
import qualified Effectful as Eff
import Effectful.Error.Dynamic (Error, throwError)
import Servant (JSON, Post, ReqBody, ServerError, type (:>))

import {{name-as-module}}.Identity.Command.Domain.AuthToken (AuthToken (..))
import {{name-as-module}}.Identity.Command.Domain.AuthTokenService (AuthTokenSvc)
import {{name-as-module}}.Identity.Command.Domain.IdentityError (IdentityError (..))
import {{name-as-module}}.Identity.Command.Domain.PasswordService (PasswordSvc)
import {{name-as-module}}.Identity.Command.Domain.User (UserError (..), mkEmail)
import {{name-as-module}}.Identity.Command.Domain.UserRepository (UserRepo)
import {{name-as-module}}.Infra.Web.ErrorResponse (badRequest, conflict, internalServerError)
import qualified {{name-as-module}}.Identity.Command.UseCase.Register as Register

type Route = "register" Servant.:> ReqBody '[JSON] RegisterRequest Servant.:> Post '[JSON] RegisterResponse

data RegisterRequest = RegisterRequest
  { email :: Text
  , name :: Text
  , password :: Text
  }
  deriving stock (Show, Generic)
  deriving anyclass (FromJSON, ToSchema)

newtype RegisterResponse = RegisterResponse
  { token :: Text
  }
  deriving stock (Show, Generic)
  deriving anyclass (ToJSON, ToSchema)

toUserError :: UserError -> ServerError
toUserError (EmailAlreadyExists _) = conflict "Error" "Email already exists" "EmailAlreadyExists"
toUserError (InvalidEmail msg) = badRequest "Error" msg "InvalidEmail"
toUserError (InvalidPassword msg) = badRequest "Error" msg "InvalidPassword"
toUserError err = badRequest "Error" (show err) "BadRequest"

toError :: IdentityError -> ServerError
toError (IdentityUserError err) = toUserError err
toError (IdentityAuthTokenError _) =
  internalServerError "Error" "Failed to generate auth token" "AuthTokenGenerationFailed"

handler ::
  ( UserRepo Eff.:> es
  , AuthTokenSvc Eff.:> es
  , PasswordSvc Eff.:> es
  , IOE Eff.:> es
  , Error ServerError Eff.:> es
  ) =>
  RegisterRequest -> Eff es RegisterResponse
handler req = do
  email <- case mkEmail req.email of
    Right e -> pure e
    Left err -> throwError $ toUserError err
  result <- Register.execute email req.name req.password
  case result of
    Left err -> throwError $ toError err
    Right (AuthToken t) -> pure $ RegisterResponse t

{-# START_FILE src/{{name-as-module}}/Identity/Infra/Web/Handler/Login.hs #-}
module {{name-as-module}}.Identity.Infra.Web.Handler.Login
  ( Route
  , handler
  ) where

import Relude

import Data.Aeson (FromJSON, ToJSON)
import Data.Swagger (ToSchema)
import Effectful (Eff)
import qualified Effectful as Eff
import Effectful.Error.Dynamic (Error, throwError)
import Servant (JSON, Post, ReqBody, ServerError, type (:>))

import {{name-as-module}}.Identity.Command.Domain.AuthToken (AuthToken (..))
import {{name-as-module}}.Identity.Command.Domain.AuthTokenService (AuthTokenSvc)
import {{name-as-module}}.Identity.Command.Domain.IdentityError (IdentityError (..))
import {{name-as-module}}.Identity.Command.Domain.PasswordService (PasswordSvc)
import {{name-as-module}}.Identity.Command.Domain.User (UserError (..), mkEmail)
import {{name-as-module}}.Identity.Command.Domain.UserRepository (UserRepo)
import {{name-as-module}}.Infra.Web.ErrorResponse (badRequest, internalServerError, unauthorized)
import qualified {{name-as-module}}.Identity.Command.UseCase.Login as Login

type Route = "login" Servant.:> ReqBody '[JSON] LoginRequest Servant.:> Post '[JSON] LoginResponse

data LoginRequest = LoginRequest
  { email :: Text
  , password :: Text
  }
  deriving stock (Show, Generic)
  deriving anyclass (FromJSON, ToSchema)

newtype LoginResponse = LoginResponse
  { token :: Text
  }
  deriving stock (Show, Generic)
  deriving anyclass (ToJSON, ToSchema)

toUserError :: UserError -> ServerError
toUserError (UserNotFoundByEmail _) = unauthorized "Error" "Invalid email or password" "AuthFailed"
toUserError PasswordMismatch = unauthorized "Error" "Invalid email or password" "AuthFailed"
toUserError (InvalidEmail msg) = badRequest "Error" msg "InvalidEmail"
toUserError err = badRequest "Error" (show err) "BadRequest"

toError :: IdentityError -> ServerError
toError (IdentityUserError err) = toUserError err
toError (IdentityAuthTokenError _) =
  internalServerError "Error" "Failed to generate auth token" "AuthTokenGenerationFailed"

handler ::
  ( UserRepo Eff.:> es
  , AuthTokenSvc Eff.:> es
  , PasswordSvc Eff.:> es
  , Error ServerError Eff.:> es
  ) =>
  LoginRequest -> Eff es LoginResponse
handler req = do
  email <- case mkEmail req.email of
    Right e -> pure e
    Left err -> throwError $ toUserError err
  result <- Login.execute email req.password
  case result of
    Left err -> throwError $ toError err
    Right (AuthToken t) -> pure $ LoginResponse t

{-# START_FILE src/{{name-as-module}}/Identity/Infra/Web/Handler/GetMe.hs #-}
module {{name-as-module}}.Identity.Infra.Web.Handler.GetMe
  ( Route
  , handler
  ) where

import Relude

import Data.Aeson (ToJSON)
import Data.Swagger (ToSchema)
import Data.Time (UTCTime)
import qualified Data.UUID as UUID
import Effectful (Eff)
import qualified Effectful as Eff
import Effectful.Error.Dynamic (Error, throwError)
import Servant (Get, JSON, ServerError, type (:>))

import {{name-as-module}}.Identity.Command.Domain.User (Email (..), User (..), UserId (..), UserError (..))
import {{name-as-module}}.Identity.Command.Domain.UserRepository (UserRepo)
import {{name-as-module}}.Infra.Web.Auth (AuthToken (..))
import {{name-as-module}}.Infra.Web.ErrorResponse (notFound, unauthorized)
import qualified {{name-as-module}}.Identity.Query.GetMe as GetMe

type Route = "me" Servant.:> Get '[JSON] MeResponse

data MeResponse = MeResponse
  { id :: Text
  , email :: Text
  , name :: Text
  , createdAt :: UTCTime
  }
  deriving stock (Show, Generic)
  deriving anyclass (ToJSON, ToSchema)

toError :: UserError -> ServerError
toError (UserNotFound _) = notFound "Error" "User not found" "UserNotFound"
toError err = notFound "Error" (show err) "NotFound"

handler ::
  ( UserRepo Eff.:> es
  , Error ServerError Eff.:> es
  ) =>
  AuthToken -> Eff es MeResponse
handler token = do
  uid <- case UUID.fromText token.userId of
    Just uuid -> pure $ UserId uuid
    Nothing -> throwError $ unauthorized "Error" "Invalid token" "InvalidToken"
  result <- GetMe.execute uid
  case result of
    Left err -> throwError $ toError err
    Right user -> do
      let UserId userUuid = user.id
      pure $ MeResponse
        { id = UUID.toText userUuid
        , email = let Email e = user.email in e
        , name = user.name
        , createdAt = user.createdAt
        }

