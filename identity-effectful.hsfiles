{-# START_FILE package.yaml #-}
name:                {{name}}
version:             0.1.0.0
github:              "{{github-username}}{{^github-username}}githubuser{{/github-username}}/{{name}}"
license:             BSD-3-Clause
author:              "{{author-name}}{{^author-name}}Author name here{{/author-name}}"
maintainer:          "{{author-email}}{{^author-email}}example@example.com{{/author-email}}"
copyright:           "{{year}}{{^year}}2024{{/year}} {{author-name}}{{^author-name}}Author name here{{/author-name}}"

extra-source-files:
- README.md
- CHANGELOG.md

description:         Please see the README on GitHub at <https://github.com/{{github-username}}{{^github-username}}githubuser{{/github-username}}/{{name}}#readme>

dependencies:
- base >= 4.7 && < 5
- relude
- uuid
- time
- text
- effectful
- effectful-th
- postgresql-simple
- resource-pool
- jose
- lens
- string-qq
- safe
- aeson
- servant
- servant-server
- servant-websockets
- warp
- wai
- http-types
- mtl
- postgresql-migration
- katip
- katip-effectful
- bcrypt
- bytestring
- websockets
- swagger2
- servant-swagger
- servant-swagger-ui
- insert-ordered-containers

default-extensions:
- ConstraintKinds
- DataKinds
- FlexibleContexts
- FlexibleInstances
- MultiParamTypeClasses
- GADTs
- TemplateHaskell
- TypeFamilies
- TypeOperators
- DeriveGeneric
- DeriveAnyClass
- DerivingStrategies
- GeneralizedNewtypeDeriving
- InstanceSigs
- KindSignatures
- LambdaCase
- OverloadedStrings
- RecordWildCards
- ScopedTypeVariables
- StandaloneDeriving
- TupleSections
- TypeApplications
- ViewPatterns
- NoImplicitPrelude
- StrictData
- DuplicateRecordFields
- OverloadedRecordDot
- QuasiQuotes

ghc-options:
- -Wall
- -Wcompat
- -Widentities
- -Wincomplete-record-updates
- -Wincomplete-uni-patterns
- -Wmissing-home-modules
- -Wpartial-fields
- -Wredundant-constraints

library:
  source-dirs: src

executables:
  {{name}}-exe:
    main:                Main.hs
    source-dirs:         app
    ghc-options:
    - -threaded
    - -rtsopts
    - -with-rtsopts=-N
    dependencies:
    - {{name}}

tests:
  {{name}}-test:
    main:                Spec.hs
    source-dirs:         test
    ghc-options:
    - -threaded
    - -rtsopts
    - -with-rtsopts=-N
    build-tools:
    - hspec-discover
    dependencies:
    - {{name}}
    - hspec
    - effectful
    - containers
    - uuid
    - time
    - http-conduit
    - aeson
    - postgresql-simple
    - warp
    - resource-pool

{-# START_FILE stack.yaml #-}
snapshot: lts-24.51

packages:
- .

extra-deps:
  - git: https://github.com/frasertweedale/hs-jose.git
    commit: '37615be74f0e3117fc44bab052df6ba5f445cd0c'
  - git: https://github.com/eldritch-cookie/katip-effectful.git
    commit: 892077f251c916e1f7f4995c746eaa9ed8a430df

{-# START_FILE .gitignore #-}
.stack-work/
*~
*.cabal

{-# START_FILE .envrc.example #-}
# Required
export DB_HOST=localhost
export DB_PORT=5432
export DB_USER=postgres
export DB_PASSWORD=postgres
export DB_DATABASE={{name}}
export JWT_SECRET=your-secret-key

# Optional
# export DB_POOL_MAX_SIZE=10
# export DB_POOL_IDLE_TIMEOUT=30
# export JWT_EXPIRY_MINUTES=1440
# export PORT=8080

{-# START_FILE README.md #-}
# {{name}}

DDD + Effectful Haskell backend with Identity bounded context.

## Getting Started

```bash
cp .envrc.example .envrc
source .envrc

stack build
stack exec {{name}}-exe
```

## Environment Variables

| Variable | Required | Default | Description |
|----------|----------|---------|-------------|
| DB_HOST | Yes | - | PostgreSQL host |
| DB_PORT | Yes | - | PostgreSQL port |
| DB_USER | Yes | - | PostgreSQL user |
| DB_PASSWORD | Yes | - | PostgreSQL password |
| DB_DATABASE | Yes | - | PostgreSQL database |
| JWT_SECRET | Yes | - | JWT signing key |
| DB_POOL_MAX_SIZE | No | 10 | Connection pool max size |
| DB_POOL_IDLE_TIMEOUT | No | 30 | Idle connection timeout (sec) |
| JWT_EXPIRY_MINUTES | No | 1440 | JWT expiry time (min) |
| PORT | No | 8080 | Server port |

## API

| Method | Path | Description | Auth |
|--------|------|-------------|------|
| POST | /api/register | Sign up | - |
| POST | /api/login | Log in | - |
| GET | /api/me | Get my profile | JWT |
| PUT | /api/me | Update profile | JWT |
| WS | /ws/echo | Echo messages | - |

Swagger UI: http://localhost:8080/swagger-ui

## Test

```bash
stack test
```

